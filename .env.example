# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY_PATH=./path/to/private-key.pem
GITHUB_INSTALLATION_ID=your_installation_id_here

# IBM ICA (IBM Consulting Advantage) Configuration - Optional AI features
ICA_API_KEY=your_ica_api_key_here
ICA_BASE_URL=https://servicesessentials.ibm.com/apis/v3
ICA_MODEL=global/anthropic.claude-sonnet-4-5-20250929-v1:0

# Analysis Configuration
MAX_FILE_SIZE=1048576
ANALYSIS_TIMEOUT=30000
MAX_FILES_PER_PR=100
ENABLE_SECURITY_SCAN=true
ENABLE_QUALITY_SCAN=true
ENABLE_PERFORMANCE_SCAN=true

# Severity Thresholds
CRITICAL_THRESHOLD=0
HIGH_THRESHOLD=3
MEDIUM_THRESHOLD=10
LOW_THRESHOLD=20

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600

# Webhook Configuration
WEBHOOK_PATH=/webhook
WEBHOOK_VERIFY_SIGNATURE=true

# Worker Configuration
WORKER_INTERVAL_MS=5000
MAX_REVIEW_COMMENTS=10

# Database (Optional - for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/code_review_db

# Redis (Optional - for caching)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# Monitoring and Logging
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_FILE_PATH=./logs/app.log